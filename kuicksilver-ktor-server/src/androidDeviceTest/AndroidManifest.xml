<!-- The device tests run the common suite against plain-HTTP servers on the loopback: cleartext is allowed there only, as an
     app would declare it; the Kuicksilver client honours it (kuicksilver-ktor-client CleartextPolicyAndroidTest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/kuicksilver_test_network_security" />
</manifest>
