<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Kuicksilver demo</string>
	<!-- The demo server runs on a machine on the local network; iOS asks the user before the app talks to it. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>The demo downloads from the Kuicksilver demo server on your local network.</string>
	<!-- URLSession (the Darwin column) to the demo server's address on the local network. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Compose Multiplatform: let the display run at 120 Hz on ProMotion iPhones. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- As samples/ios: the app embeds OpenSSL (TLS 1.3 for QUIC and HTTP/3); see docs/guide/ios.md, "Export compliance". -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
