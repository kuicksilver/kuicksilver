# The interop endpoint's stop request (StopSignal.native.kt): a SIGTERM/SIGINT handler in C that only stores a volatile
# sig_atomic_t and puts both signals back to their default action (POSIX lists signal() as async-signal-safe), so it is safe on
# whatever thread the signal interrupts, a thread the Kotlin runtime knows or not, and a second signal ends a process whose
# stop hangs. Kotlin reads the flag from a coroutine.
package = io.kuicksilver.interop.stopsignal
headers = signal.h
---
static volatile sig_atomic_t ksl_interop_stop_flag = 0;

static void ksl_interop_on_stop(int sig) {
    (void)sig;
    ksl_interop_stop_flag = 1;
    signal(SIGTERM, SIG_DFL);
    signal(SIGINT, SIG_DFL);
}

/* Installs the handler for SIGTERM and SIGINT; 0 on success, -1 when the system refused one. */
static inline int ksl_interop_install_stop(void) {
    ksl_interop_stop_flag = 0;
    if (signal(SIGTERM, ksl_interop_on_stop) == SIG_ERR) return -1;
    if (signal(SIGINT, ksl_interop_on_stop) == SIG_ERR) return -1;
    return 0;
}

/* Whether a stop signal arrived. */
static inline int ksl_interop_stop_requested(void) { return ksl_interop_stop_flag != 0; }

/* Raises SIGTERM in this process (tests). */
static inline int ksl_interop_raise_stop(void) { return raise(SIGTERM); }
