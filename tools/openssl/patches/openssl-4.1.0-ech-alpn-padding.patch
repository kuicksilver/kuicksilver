+int SSL_CTX_ech_set_alpn_pad_target(SSL_CTX *ctx, size_t target)
+{
+    if (ctx == NULL)
+        return 0;
+    if (target > OSSL_ECH_MAX_ALPN_EXT_LEN) {
+        ERR_raise(ERR_LIB_SSL, ERR_R_PASSED_INVALID_ARGUMENT);
+        return 0;
+    }
+    ctx->ext.ech.alpn_pad_target = target;
+    return 1;
+}
