@@ -685,6 +687,20 @@
  * a padded cleartext of 128 octets, the ciphertext will be 144
  * octets.
  */
+/*
+ * RFC 9849, section 6.1.3: "Clients SHOULD pad this extension [ALPN] by
+ * rounding up to the total size of the longest ALPN extension across all
+ * application profiles." The padding the inner ALPN extension needs to reach
+ * alpn_pad_target (SSL_ech_set_alpn_pad_target()); 0 without a target
+ */
+size_t ossl_ech_alpn_padding(const SSL_CONNECTION *s)
+{
+    size_t have = s->ext.alpn != NULL ? 4 + 2 + s->ext.alpn_len : 0;
+
+    return s->ext.ech.alpn_pad_target > have
+        ? s->ext.ech.alpn_pad_target - have : 0;
+}
+
 size_t ossl_ech_calc_padding(SSL_CONNECTION *s, OSSL_ECHSTORE_ENTRY *ee,
     size_t encoded_len)
 {
@@ -707,6 +723,8 @@
             innersnipadding = (int)mnl + 9;
         }
     }
+    /* and the ALPN extension's, before the whole is rounded up */
+    innersnipadding += ossl_ech_alpn_padding(s);
     /* padding is after the inner client hello has been encoded */
     length_with_snipadding = innersnipadding + (int)encoded_len;
     length_of_padding = 31 - ((length_with_snipadding - 1) % 32);
