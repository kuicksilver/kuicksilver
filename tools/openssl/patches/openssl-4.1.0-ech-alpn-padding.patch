+int SSL_ech_set_alpn_pad_target(SSL *ssl, size_t target)
+{
+    SSL_CONNECTION *s = SSL_CONNECTION_FROM_SSL(ssl);
+
+    if (s == NULL)
+        return 0;
+    if (target > OSSL_ECH_MAX_ALPN_EXT_LEN) {
+        ERR_raise(ERR_LIB_SSL, ERR_R_PASSED_INVALID_ARGUMENT);
+        return 0;
+    }
+    s->ext.ech.alpn_pad_target = target;
+    return 1;
+}
+
