             senderpub, &senderpub_len,
--- a/ssl/ech/ech_local.h
+++ b/ssl/ech/ech_local.h
@@ -364,6 +364,8 @@
 int ossl_ech_same_ext(SSL_CONNECTION *s, WPACKET *pkt);
