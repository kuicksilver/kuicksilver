+/*
+ * Whether a real ECH offer would compress the ClientHello extension |type| into
+ * ech_outer_extensions: a built-in one marked so, or a custom one (see
+ * custom_ext_add()). Used to size GREASE like a real offer.
+ */
+int ossl_ech_type_compressed(unsigned int type)
+{
+    size_t i;
+
+    for (i = 0; i < OSSL_NELEM(ext_defs); i++)
+        if (ext_defs[i].type == type)
+            return ext_defs[i].ech_handling == OSSL_ECH_HANDLING_COMPRESS;
+    return 1;
+}
+
 /* as needed, repeat extension from inner in outer handling compression */
 int ossl_ech_same_ext(SSL_CONNECTION *s, WPACKET *pkt)
 {
--- a/ssl/statem/extensions_clnt.c
+++ b/ssl/statem/extensions_clnt.c
@@ -2858,6 +2858,37 @@
 }
 
 /*
+ * The length of the pre_shared_key extension tls_construct_ctos_psk() will
+ * write into this (first) ClientHello, 0 when none: for sizing GREASE like a
+ * real offer, whose inner ClientHello carries the same extension.
+ */
+size_t ossl_ech_grease_psk_len(SSL_CONNECTION *s)
+{
+    SSL_CTX *sctx = SSL_CONNECTION_GET_CTX(s);
+    const EVP_MD *md;
+    size_t ids = 0, binders = 0;
+    int size;
+
+    if (s->session->ssl_version != TLS1_3_VERSION
+        || (s->session->ext.ticklen == 0 && s->psksession == NULL))
+        return 0;
+    if (s->session->ext.ticklen != 0 && s->session->cipher != NULL
+        && (md = ssl_md(sctx, s->session->cipher->algorithm2)) != NULL
+        && tls13_check_tick_lifetime_hint(s)
+        && (size = EVP_MD_get_size(md)) > 0) {
+        ids += 2 + s->session->ext.ticklen + 4;
+        binders += 1 + (size_t)size;
+    }
+    if (s->psksession != NULL && s->psksession->cipher != NULL
+        && (md = ssl_md(sctx, s->psksession->cipher->algorithm2)) != NULL
+        && (size = EVP_MD_get_size(md)) > 0) {
+        ids += 2 + s->psksession_id_len + 4;
+        binders += 1 + (size_t)size;
+    }
+    return ids == 0 ? 0 : 4 + 2 + ids + 2 + binders;
+}
+
